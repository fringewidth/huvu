**/node_modules
**/__pycache__
**/*.pyc
.claude/
frontend/dist/
frontend/dist-phone/
frontend/dist-firetv/
frontend/android/
frontend/.env*
docs/
hermes-skills/
backend/.venv/
backend/data/
backend/tests/
backend/.env
backend/huvu.toml
