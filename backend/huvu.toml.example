# Copy to huvu.toml (gitignored). Secrets come from the environment:
#   HERMES_API_KEY   the API_SERVER_KEY of Hermes's default profile, the household's
#   HUVU_MCP_TOKEN   the token the default profile sends to /mcp
#   HUVU_FCM_CREDENTIALS   path of a Firebase service account's JSON key; turns on native push
# Users, devices, and each user's profile key and token live in the database.
# Add users with `uv run huvu user add <name>`.

data_dir = "data"
public_url = "http://localhost:3001"
host = "0.0.0.0"
port = 3001
cors_origins = ["*"]
# huvu writes a Hermes skill per source into <data_dir>/skills, and links each
# into the folder every Hermes profile reads (skills.external_dirs) at every
# start. The defaults: data/skills, and the repo's hermes-skills/.
# skills_dir = "data/skills"
# hermes_skills_dir = "../hermes-skills"

[auth]
mode = "on"
# With mode = "off", for development on localhost only, a request without a
# token comes from a development phone owned by this user.
# dev_user = "you"

[hermes]
url = "http://localhost:8642"

# Autonomy per action, over each driver's default: silent, notify or ask.
# An action a driver marks requires_human always asks, whatever this says.
[policy]
# "ha.bedroom_ac_set" = "silent"

# [[sources]]
# name = "tuya"
# driver = "huvu_drivers.tuya:TuyaSource"
# options = { env_file = "~/.tuya.env" }

# Home Assistant. HA_TOKEN (environment or backend/.env) is a long-lived
# access token of huvu's own HA user, which must be an administrator.
# `users` maps HA user ids to huvu users, so a change made in the HA app
# counts as that person's. What HA must look like: docs/home-assistant.md.
# [[sources]]
# name = "ha"
# driver = "huvu_drivers.ha:HomeAssistant"
# options = { url = "http://homeassistant.local:8123", users = { "<HA user id>" = "<huvu user>" } }
